<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sms_card_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sms_card_enabled_title" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sms_card_enabled_summary" android:textAppearance="?attr/textAppearanceBodyMedium" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/sms_card_confidence_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
  <com.google.android.material.slider.Slider android:id="@+id/sms_card_confidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.0" android:valueTo="1.0" android:stepSize="0.1" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/sms_card_types_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
  <LinearLayout android:id="@+id/sms_card_type_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <com.google.android.material.button.MaterialButton android:id="@+id/sms_card_history" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/sms_card_history_title" />
  <com.google.android.material.button.MaterialButton android:id="@+id/sms_card_clear" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sms_card_clear_action" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/sms_card_advanced_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
  <com.google.android.material.button.MaterialButton android:id="@+id/sms_card_import" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sms_card_import" />
  <com.google.android.material.button.MaterialButton android:id="@+id/sms_card_export" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sms_card_export" />
  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sms_card_external_access" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/sms_card_external_title" />
 </LinearLayout>
</ScrollView>
