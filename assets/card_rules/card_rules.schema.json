{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gx-bangsong.github.io/GKUIMessage/schema/card-rules-v1.json",
  "title": "GKUIMessage local SMS card rule",
  "description": "A single independently validated local parser rule. All patterns use Android JVM Java regular-expression syntax.",
  "type": "object",
  "required": ["$schema", "version", "cardType", "triggers", "fields"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "const": 1},
    "cardType": {
      "type": "string",
      "enum": ["BANK_CARD", "EXPRESS_CARD", "TRAIN_CARD", "FLIGHT_CARD", "APPOINTMENT_CARD", "RECHARGE_CARD"]
    },
    "triggers": {
      "type": "object",
      "required": ["keywords", "senderPrefixes"],
      "additionalProperties": false,
      "properties": {
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "senderPrefixes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9+]{3,20}$"}, "uniqueItems": true}
      },
      "anyOf": [{"properties": {"keywords": {"minItems": 1}}}, {"properties": {"senderPrefixes": {"minItems": 1}}}]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "required", "patterns", "weight"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
          "required": {"type": "boolean"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "description": "Java Pattern expression; use capturing groups for the extracted value."}
          }
        }
      }
    },
    "examples": {"type": "array", "items": {"type": "object"}}
  }
}
