{"$schema":"card_rules.schema.json","version":1,"cardType":"TRAIN_CARD","triggers":{"keywords":["车次","高铁","动车","火车","检票","乘车","候车"],"senderPrefixes":[]},"fields":[{"name":"trainNumber","required":true,"weight":0.5,"patterns":["\\b([GDCZTK]\\d{1,5})\\b"]},{"name":"route","required":false,"weight":0.25,"patterns":["(?:从|由)([^至到-]{2,16})(?:至|到)([^，。；;]{2,16})"]},{"name":"departureTime","required":false,"weight":0.15,"patterns":["(\\d{1,2}[月/-]\\d{1,2}[日\\s]+\\d{1,2}:\\d{2})"]},{"name":"seatNumber","required":false,"weight":0.1,"patterns":["(?:座位|席位)[：:]?\\s*([0-9]+车[0-9A-Z]+号?)"]}]}
