{
  "$schema": "card_rules.schema.json",
  "version": 1,
  "cardType": "EXPRESS_CARD",
  "triggers": {
    "keywords": ["快递", "包裹", "揽收", "派送", "签收", "取件", "运单", "物流"],
    "senderPrefixes": ["95338", "95543", "95559", "95706", "95353", "4001182211"]
  },
  "fields": [
    {
      "name": "trackingNumber",
      "required": true,
      "weight": 0.55,
      "patterns": [
        "(?:运单号|快递单号|单号)[：:]?\\s*([A-Z0-9]{8,24})",
        "(?:SF|YT|STO|JD)[：:]?\\s*([A-Z0-9]{8,24})",
        "(?:顺丰|圆通|申通|韵达|京东)[^A-Z0-9]{0,12}([A-Z0-9]{10,24})"
      ]
    },
    {
      "name": "pickupCode",
      "required": false,
      "weight": 0.15,
      "patterns": [
        "(?:取件码|凭取件码|货架号)[：:]?\\s*([A-Z0-9-]{4,10})",
        "请凭\\s*([A-Z0-9-]{4,10})\\s*取件"
      ]
    },
    {
      "name": "estimatedDelivery",
      "required": false,
      "weight": 0.15,
      "patterns": [
        "(?:预计|将于|预计在)\\s*([0-9]{1,2}[月/-][0-9]{1,2}[日\\s][0-9:]{0,5})",
        "([0-9]{1,2}:[0-9]{2})前送达"
      ]
    },
    {
      "name": "location",
      "required": false,
      "weight": 0.15,
      "patterns": [
        "(?:已放至|存放于|请到)([^，。；;]{2,30}(?:驿站|丰巢|快递柜|自提点|柜))",
        "(?:地址|地点)[：:]?\\s*([^，。；;]{2,30})"
      ]
    }
  ],
  "examples": [
    {"sender": "95338", "sms": "顺丰速运：您的快递运单号SF123456789012已到达菜鸟驿站，取件码：A1234。"},
    {"sender": "95543", "sms": "申通快递提醒：快递单号STO1234567890正在派送，请保持电话畅通。"},
    {"sender": "95559", "sms": "圆通速递YT12345678901234已签收，如有疑问请联系客服。"},
    {"sender": "95706", "sms": "韵达快递：您的包裹运单号YD123456789012已揽收，预计06月20日送达。"},
    {"sender": "95353", "sms": "京东物流：订单JD123456789012已放至丰巢快递柜，凭取件码5678领取。"}
  ]
}
