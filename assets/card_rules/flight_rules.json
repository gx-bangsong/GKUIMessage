{"$schema":"card_rules.schema.json","version":1,"cardType":"FLIGHT_CARD","triggers":{"keywords":["航班","登机","值机","行李","航空"],"senderPrefixes":[]},"fields":[{"name":"flightNumber","required":true,"weight":0.5,"patterns":["\\b([A-Z]{2}\\d{3,4})\\b"]},{"name":"route","required":false,"weight":0.2,"patterns":["([A-Z]{3})\\s*[-至到]\\s*([A-Z]{3})","([^至到]{2,16})(?:至|到)([^，。；;]{2,16})"]},{"name":"departureTime","required":false,"weight":0.2,"patterns":["(\\d{1,2}[月/-]\\d{1,2}[日\\s]+\\d{1,2}:\\d{2})"]},{"name":"gate","required":false,"weight":0.1,"patterns":["(?:登机口|登机)[：:]?\\s*([A-Z]?\\d{1,3})"]}]}
